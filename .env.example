# Fill these in later
SERPAPI_API_KEY=
APIFY_API_TOKEN=

# SerpAPI network resilience (seconds / retry count)
SERPAPI_CONNECT_TIMEOUT=10
SERPAPI_READ_TIMEOUT=120
SERPAPI_RETRIES=2

# Market settings (defaults target India)
PL_COUNTRY=in
PL_GOOGLE_DOMAIN=google.co.in
PL_AMAZON_DOMAIN=amazon.in

# --- Apify actors (2-stage: discover products, then enrich the cheapest few with page-level details)
APIFY_ECOM_ACTOR=apify/e-commerce-scraping-tool
APIFY_ECOM_MODE=Sellers                 # Sellers | Products | "Google Listing"
APIFY_FLIPKART_DETAILS_ACTOR=piotrv1001/flipkart-product-details-scraper
APIFY_BANK_OFFERS_ACTOR=pale_tapestry/bank-offers-aggregator-actor
APIFY_ENRICHERS=flipkart_details,bank_offers   # empty = no enrichment (cheapest, thinnest data)
APIFY_ENRICH_LIMIT=5                    # product URLs enriched per marketplace per search
# Patch actor inputs without code changes, keyed by: ecom_search | flipkart_details | bank_offers
# APIFY_EXTRA_INPUT_JSON={"bank_offers": {"useProxy": true}}

# Runtime PostgreSQL. Keep the local URL for development, or replace it in .env with
# a Neon pooled connection URL. Cloud connections must use sslmode=require.
PL_DATABASE_URL=postgresql://pricelens:pricelens_local@localhost:5433/pricelens

# Tests always use this isolated local database setting and never fall back to the
# runtime PL_DATABASE_URL. This prevents tests from creating schemas in Neon.
PL_TEST_DATABASE_URL=postgresql://pricelens:pricelens_local@localhost:5433/pricelens

# History analyst: refuse to give timing advice below this many days of price history
PL_MIN_HISTORY_DAYS=180

# Use the pooled Neon URI for normal application traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Use the direct Neon URI for migrations, policy ingestion, and embedding builds.
DATABASE_DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Isolated local PostgreSQL used by integration tests (docker compose).
TEST_DATABASE_URL=postgresql://pricelens:pricelens_local@localhost:5433/pricelens

# One OpenAI credential is shared by all three agents and, when enabled, policy
# embeddings. Keep the real value only in the ignored .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Agent 3 uses OpenAI embeddings stored in Neon pgvector. Tests inject fakes;
# local/hash embedding backends are not accepted by application configuration.
POLICY_EMBEDDINGS=openai
POLICY_EMBEDDING_MODEL=text-embedding-3-small
POLICY_EMBEDDING_DIMENSIONS=1536
POLICY_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Agent 3 policy-search planning and narrative are optional; deterministic
# retailer searches and citation verification work when it is disabled.
ELIGIBILITY_AGENT_LLM_ENABLED=true
ELIGIBILITY_AGENT_LLM_BASE_URL=https://api.openai.com/v1
ELIGIBILITY_AGENT_LLM_MODEL=gpt-5-mini
ELIGIBILITY_OFFER_FRESHNESS_MINUTES=60

# Provider credentials. Never commit real values.
SERPAPI_API_KEY=
APIFY_API_TOKEN=

# India-only market discovery.
MARKET_COUNTRY=in
MARKET_GOOGLE_DOMAIN=google.co.in
MARKET_AMAZON_DOMAIN=amazon.in

# SerpAPI resilience. Amazon Product API enrichment stays optional; discovery
# always uses Amazon Search plus Google Shopping.
SERPAPI_CONNECT_TIMEOUT=10
SERPAPI_READ_TIMEOUT=120
SERPAPI_RETRIES=2
SERPAPI_ENRICH_AMAZON=false

# Agent 2 database-first freshness windows. Provider calls are skipped while
# the corresponding stored evidence remains within these limits.
MARKET_PRICE_FRESHNESS_MINUTES=60
MARKET_AVAILABILITY_FRESHNESS_MINUTES=30
MARKET_DELIVERY_FRESHNESS_MINUTES=30
MARKET_PROMOTION_FRESHNESS_MINUTES=180
MARKET_SELLER_FRESHNESS_MINUTES=1440
MARKET_PRODUCT_FRESHNESS_MINUTES=10080

# Live APIs are checked first; PostgreSQL fills missing retailers or becomes the
# fallback when providers fail. Use database_first to reduce provider spend, or
# database_only for read-only stored analysis.
MARKET_PROVIDER_POLICY=api_first

# Grounded planning and narrative are enabled; deterministic calculations and
# evidence verification still control execution and the <=150 word summary.
MARKET_AGENT_LLM_ENABLED=true
# Agent 2 may override the shared model and endpoint, but always uses the shared
# OPENAI_API_KEY.
MARKET_AGENT_LLM_BASE_URL=https://api.openai.com/v1
MARKET_AGENT_LLM_MODEL=gpt-5-mini

# Apify two-stage discovery and seller/promotion enrichment.
APIFY_ECOM_ACTOR=apify/e-commerce-scraping-tool
APIFY_ECOM_MODE=Products
APIFY_FLIPKART_DETAILS_ACTOR=piotrv1001/flipkart-product-details-scraper
APIFY_BANK_OFFERS_ACTOR=pale_tapestry/bank-offers-aggregator-actor
APIFY_ENRICHERS=flipkart_details,bank_offers
APIFY_ENRICH_LIMIT=5
# APIFY_EXTRA_INPUT_JSON={"bank_offers":{"useProxy":true}}
